DATABASE_PATH=/data/pulsefeed.db
APP_BASE_URL=https://your-app.up.railway.app
SESSION_SECRET=replace-with-at-least-32-random-characters
COOKIE_SECURE=true
# Public home creates an isolated visitor session in any browser.
PUBLIC_ACCESS_ENABLED=true
# Admin entry: https://your-app.up.railway.app/?admin_key=<ADMIN_ACCESS_TOKEN>
# Change the parameter name if desired. Generate the token privately with
# python -c 'import secrets; print(secrets.token_urlsafe(48))'
# Seal ADMIN_ACCESS_TOKEN and SESSION_SECRET in Railway; never expose to JS.
# A blank token disables URL admin sign-in. Rotating/removing it revokes grants.
ADMIN_ACCESS_PARAM=admin_key
ADMIN_ACCESS_TOKEN=
ADMIN_SESSION_SECONDS=3600
VISITOR_LIMIT_PER_MINUTE=20
PULSEFEED_FAKE_MODE=false
# Set false to serve the production UI/admin while provider endpoints are being connected.
# Paused mode makes no provider calls and does not admit generation jobs.
INFERENCE_ENABLED=true
INFERENCE_PROVIDER=runpod
RUNPOD_API_KEY=
RUNPOD_QWEN_ENDPOINT_ID=
RUNPOD_FLUX_ENDPOINT_ID=
# Optional real local DGX workers via SSH loopback forwarding; never browser inputs.
# INFERENCE_PROVIDER=local_http
LOCAL_QWEN_URL=http://127.0.0.1:8181
LOCAL_FLUX_URL=http://127.0.0.1:8182
LOCAL_WORKER_TOKEN=
# Local live mode may use COOKIE_SECURE=false only with loopback APP_BASE_URL.
# Use a separate DATABASE_PATH for each provider/endpoint profile.
# Configure only actual Railway reverse-proxy addresses/CIDRs; never trust all IPs.
TRUSTED_PROXY_CIDRS=
SESSION_SECONDS=86400
ACCESS_LINK_SECONDS=1800
ITEM_DEADLINE_SECONDS=600
# Square image preset for new jobs; deploy the compact FLUX worker first.
FLUX_IMAGE_SIZE=512
# Safe default: one job per model and two started stories.
# For up to three workers per endpoint, set these to 3 and 6 respectively.
COORDINATOR_STAGE_CONCURRENCY=1
COORDINATOR_PIPELINE_SIZE=2
IMAGE_QUOTA_PER_HOUR=30
# Max simultaneous unexpired reader pages per visitor; exact replay is free.
# Legacy SAVED_FEED_LIMIT is accepted only when LIVE_VIEW_LIMIT is unset.
LIVE_VIEW_LIMIT=5
EXCHANGE_LIMIT_PER_MINUTE=10
RSS_LIMIT_PER_MINUTE=10
SUBMIT_LIMIT_PER_MINUTE=5
POLL_LIMIT_PER_MINUTE=120

# Seeds only: after first initialization, admin policy in SQLite is authoritative.
GLOBAL_DAILY_IMAGE_LIMIT=100
# Stories selected per new reader page, independent of prior views of the URL (1–10).
FEED_ARTICLE_LIMIT=10
GLOBAL_HOURLY_GENERATION_LIMIT=30
ADMIN_WRITE_LIMIT_PER_MINUTE=10

FLUX_RUNTIME_PROFILE=dgx-spark
MODEL_REVISION=e7b7dc27f91deacad38e78976d1f2b499d76a294
HF_TOKEN=
HF_HOME=/models/huggingface
HF_HUB_CACHE=/models/huggingface/hub
HF_HUB_DISABLE_TELEMETRY=1
HF_HUB_DISABLE_XET=1
HF_HUB_ETAG_TIMEOUT=10
HF_HUB_DOWNLOAD_TIMEOUT=30
MODEL_CACHE_SOURCE=volume
# Set true after explicit prefetch has populated this exact revision.
MODEL_CACHE_OFFLINE=false
# Legacy FLUX_LOCAL_FILES_ONLY works only when unset here or in agreement.
FLUX_STARTUP_TIMEOUT_SECONDS=600
FLUX_EXECUTION_TIMEOUT_SECONDS=540
TOKENIZERS_PARALLELISM=false
NVIDIA_IMEX_CHANNELS=0
# Gateway is root-owned; populate a private token via the root local env setup.
LOCAL_WORKER_FACTORY=local_factory:create_worker
LOCAL_WORKER_PORT=8000
LOCAL_WORKER_TOKEN=
LOCAL_GPU_LOCK=/coordination/gpu.lock

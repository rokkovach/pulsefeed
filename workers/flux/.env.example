MODEL_REVISION=e7b7dc27f91deacad38e78976d1f2b499d76a294
FLUX_RUNTIME_PROFILE=runpod
# Only set if the fixed model requires access; configure as a Runpod secret.
HF_TOKEN=
# Select provider-managed caching only after configuring that model on Runpod.
# Managed mode ignores HF_HUB_CACHE and uses /runpod-volume/huggingface-cache/hub.
MODEL_CACHE_SOURCE=runpod-managed
# Require a complete exact revision; no network or latest-revision fallback.
MODEL_CACHE_OFFLINE=true
# Used only with MODEL_CACHE_SOURCE=volume, never for generated images.
HF_HOME=/runpod-volume/huggingface
HF_HUB_CACHE=/runpod-volume/huggingface/hub
HF_HUB_DISABLE_TELEMETRY=1
HF_HUB_DISABLE_XET=1
HF_HUB_ETAG_TIMEOUT=10
HF_HUB_DOWNLOAD_TIMEOUT=30
TOKENIZERS_PARALLELISM=false
# SDK DEBUG output includes image payloads and must stay disabled.
RUNPOD_LOG_LEVEL=INFO
# Legacy FLUX_LOCAL_FILES_ONLY=0|1 remains supported when MODEL_CACHE_OFFLINE
# is unset. Explicit old/new values must agree if both are configured.
FLUX_STARTUP_TIMEOUT_SECONDS=600
FLUX_EXECUTION_TIMEOUT_SECONDS=540

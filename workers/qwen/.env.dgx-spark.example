# Explicit local hardware profile; does not change the Runpod default.
QWEN_RUNTIME_PROFILE=dgx-spark
MODEL_REVISION=ccd10a893cbca613259517c3efe08e151ddf2b8e
MODEL_CACHE_DIR=/model-cache/huggingface
MODEL_CACHE_SOURCE=volume
# Optional after successful prefetch; fails readiness rather than downloading missing files.
MODEL_CACHE_OFFLINE=false
INITIALIZATION_TIMEOUT_SECONDS=480
EXECUTION_TIMEOUT_SECONDS=240
LOCAL_WORKER_FACTORY=local_factory:create_worker
LOCAL_WORKER_PORT=8000
# Shared gateway owns authentication and cross-model serialization.
LOCAL_WORKER_TOKEN=replace-with-a-random-local-secret
LOCAL_GPU_LOCK=/coordination/gpu.lock
HF_TOKEN=

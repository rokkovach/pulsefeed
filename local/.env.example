# Copy using ./local/control.sh init-env; generated secrets are never printed.
# Raw KEY=value format: no shell substitutions, quotes or export statements.
LOCAL_WORKER_TOKEN=GENERATED_BY_INIT_ENV
# Retained in-memory job slots per worker (1–256); no unexpired result eviction.
LOCAL_RESULT_CAPACITY=128
SESSION_SECRET=GENERATED_BY_INIT_ENV
# Reusable private admin URL; generated by init-env, never printed by startup.
ADMIN_ACCESS_PARAM=admin_key
ADMIN_ACCESS_TOKEN=GENERATED_BY_INIT_ENV
ADMIN_SESSION_SECONDS=3600
PUBLIC_ACCESS_ENABLED=true
VISITOR_LIMIT_PER_MINUTE=20
HF_TOKEN=
LOCAL_QWEN_URL=http://127.0.0.1:8181
LOCAL_FLUX_URL=http://127.0.0.1:8182
APP_BASE_URL=http://127.0.0.1:8000
# Separate laptop database; never point local testing at a Runpod database.
DATABASE_PATH=local/data/pulsefeed.db
APP_PORT=8000
# Optional: set each to an absolute Spark cache directory. Blank uses named volumes.
QWEN_CACHE_PATH=
FLUX_CACHE_PATH=
# Set true only after prefetching the complete pinned checkpoint into each cache.
QWEN_CACHE_OFFLINE=false
FLUX_CACHE_OFFLINE=false

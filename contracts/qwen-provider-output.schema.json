{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:pulsefeed:v1:qwen-provider-output",
  "type": "object",
  "properties": {
    "result": {
      "type": "object",
      "properties": {
        "schema_version": {
          "const": 1,
          "type": "integer"
        },
        "stage": {
          "const": "qwen"
        },
        "run_id": {
          "anyOf": [
            {
              "type": "string",
              "format": "uuid"
            },
            {
              "type": "null"
            }
          ]
        },
        "invocation_id": {
          "anyOf": [
            {
              "type": "string",
              "format": "uuid"
            },
            {
              "type": "null"
            }
          ]
        },
        "ok": {
          "type": "boolean"
        },
        "model": {
          "type": "object",
          "properties": {
            "id": {
              "const": "nvidia/Qwen3-8B-NVFP4"
            },
            "revision": {
              "anyOf": [
                {
                  "type": "string",
                  "minLength": 1
                },
                {
                  "type": "null"
                }
              ]
            },
            "precision": {
              "anyOf": [
                {
                  "type": "string",
                  "minLength": 1
                },
                {
                  "type": "null"
                }
              ]
            },
            "runtime": {
              "anyOf": [
                {
                  "type": "string",
                  "minLength": 1
                },
                {
                  "type": "null"
                }
              ]
            }
          },
          "required": [
            "id",
            "revision",
            "precision",
            "runtime"
          ],
          "additionalProperties": false
        },
        "data": {
          "anyOf": [
            {
              "type": "object",
              "properties": {
                "prompt": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 2000
                }
              },
              "required": [
                "prompt"
              ],
              "additionalProperties": false
            },
            {
              "type": "null"
            }
          ]
        },
        "usage": {
          "type": "object",
          "properties": {
            "input_tokens": {
              "anyOf": [
                {
                  "type": "integer",
                  "minimum": 0
                },
                {
                  "type": "null"
                }
              ]
            },
            "output_tokens": {
              "anyOf": [
                {
                  "type": "integer",
                  "minimum": 0
                },
                {
                  "type": "null"
                }
              ]
            },
            "total_tokens": {
              "anyOf": [
                {
                  "type": "integer",
                  "minimum": 0
                },
                {
                  "type": "null"
                }
              ]
            }
          },
          "required": [
            "input_tokens",
            "output_tokens",
            "total_tokens"
          ],
          "additionalProperties": false
        },
        "timings": {
          "type": "object",
          "properties": {
            "inference_ms": {
              "anyOf": [
                {
                  "type": "number",
                  "minimum": 0
                },
                {
                  "type": "null"
                }
              ]
            }
          },
          "required": [
            "inference_ms"
          ],
          "additionalProperties": false
        },
        "counters": {
          "type": "object",
          "properties": {
            "inference_attempts": {
              "anyOf": [
                {
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 2
                },
                {
                  "type": "null"
                }
              ]
            },
            "inference_retries": {
              "anyOf": [
                {
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 1
                },
                {
                  "type": "null"
                }
              ]
            },
            "dependency_retries": {
              "anyOf": [
                {
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 1
                },
                {
                  "type": "null"
                }
              ]
            }
          },
          "required": [
            "inference_attempts",
            "inference_retries",
            "dependency_retries"
          ],
          "additionalProperties": false
        },
        "error": {
          "anyOf": [
            {
              "type": "object",
              "properties": {
                "code": {
                  "enum": [
                    "INVALID_INPUT",
                    "INPUT_TOO_LARGE",
                    "UNSUPPORTED_SCHEMA",
                    "MODEL_NOT_READY",
                    "MODEL_ACCESS_DENIED",
                    "UNSUPPORTED_RUNTIME",
                    "DEPENDENCY_UNAVAILABLE",
                    "GPU_OOM",
                    "INFERENCE_FAILED",
                    "INFERENCE_OUTCOME_UNKNOWN",
                    "INVALID_MODEL_OUTPUT",
                    "OUTPUT_TOO_LARGE",
                    "DEADLINE_EXCEEDED",
                    "CANCELLED"
                  ]
                },
                "message": {
                  "type": "string",
                  "minLength": 1
                },
                "retryable": {
                  "type": "boolean"
                }
              },
              "required": [
                "code",
                "message",
                "retryable"
              ],
              "additionalProperties": false
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "schema_version",
        "stage",
        "run_id",
        "invocation_id",
        "ok",
        "model",
        "data",
        "usage",
        "timings",
        "counters",
        "error"
      ],
      "additionalProperties": false,
      "allOf": [
        {
          "if": {
            "properties": {
              "ok": {
                "const": true
              }
            }
          },
          "then": {
            "properties": {
              "data": {
                "type": "object",
                "properties": {
                  "prompt": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 2000
                  }
                },
                "required": [
                  "prompt"
                ],
                "additionalProperties": false
              },
              "error": {
                "type": "null"
              },
              "run_id": {
                "type": "string",
                "format": "uuid"
              },
              "invocation_id": {
                "type": "string",
                "format": "uuid"
              },
              "counters": {
                "properties": {
                  "inference_attempts": {
                    "anyOf": [
                      {
                        "type": "integer",
                        "minimum": 1,
                        "maximum": 2
                      },
                      {
                        "type": "null"
                      }
                    ]
                  }
                }
              },
              "model": {
                "type": "object",
                "properties": {
                  "id": {
                    "const": "nvidia/Qwen3-8B-NVFP4"
                  },
                  "revision": {
                    "type": "string",
                    "minLength": 1
                  },
                  "precision": {
                    "type": "string",
                    "minLength": 1
                  },
                  "runtime": {
                    "type": "string",
                    "minLength": 1
                  }
                },
                "required": [
                  "id",
                  "revision",
                  "precision",
                  "runtime"
                ],
                "additionalProperties": false
              }
            }
          },
          "else": {
            "properties": {
              "data": {
                "type": "null"
              },
              "error": {
                "type": "object",
                "properties": {
                  "code": {
                    "enum": [
                      "INVALID_INPUT",
                      "INPUT_TOO_LARGE",
                      "UNSUPPORTED_SCHEMA",
                      "MODEL_NOT_READY",
                      "MODEL_ACCESS_DENIED",
                      "UNSUPPORTED_RUNTIME",
                      "DEPENDENCY_UNAVAILABLE",
                      "GPU_OOM",
                      "INFERENCE_FAILED",
                      "INFERENCE_OUTCOME_UNKNOWN",
                      "INVALID_MODEL_OUTPUT",
                      "OUTPUT_TOO_LARGE",
                      "DEADLINE_EXCEEDED",
                      "CANCELLED"
                    ]
                  },
                  "message": {
                    "type": "string",
                    "minLength": 1
                  },
                  "retryable": {
                    "type": "boolean"
                  }
                },
                "required": [
                  "code",
                  "message",
                  "retryable"
                ],
                "additionalProperties": false
              }
            }
          }
        }
      ]
    }
  },
  "required": [
    "result"
  ],
  "additionalProperties": false
}
